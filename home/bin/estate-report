#!/bin/sh
# estate-report — open work across the estate, in one pass.
#
# WHY THIS EXISTS. Three tools cover pieces of the estate and none answers
# "where is the work": repo-audit.sh checks settings, repo-review checks one
# repo's drift, bundle-issues triages one backlog. Choosing which repo to open
# was guesswork, and guesswork defaults to whichever repo was open last.
#
# WHY IT IS A SCRIPT AND NOT SKILL PROSE. Every number here is arithmetic
# against a threshold -- "5+ bot PRs with the oldest over 14 days" is a
# function, not a judgement. An agent evaluating that forty times will drift,
# and nothing announces it when one comes out wrong. Two further reasons: the
# forty repos of issue JSON never enter an agent's context, only the rendered
# table does (#425 was three tool-result overflows in one session); and the
# same input always produces the same table, so two runs can be diffed.
#
# The judgement stays with the agent -- which repo to actually open, and why.
# That is what the skill is for. This only ever produces evidence.
#
# WHY jq DOES THE DATES. `date` is the sharpest BSD/GNU split in this estate:
# `date -d` is GNU, `date -j -f` is BSD, and a script that picks one works on
# the machine it was written on and fails on the other. jq's fromdateiso8601
# is the same everywhere, so no age arithmetic here goes near `date` at all.
#
# OUTPUT IS EVIDENCE. It names private repos and what is wrong in them. Print
# it, pipe it, keep it in a scratch directory -- never commit it, and never
# paste a real run into the skill or an issue as an "example". The estate's
# standing line is standard public, evidence private.
#
# Usage:
#   estate-report                 render the table
#   estate-report --json          emit the aggregate, for another renderer
#   estate-report --owner NAME    default: pmgledhill102
#   estate-report --repos a,b,c   skip enumeration, use this list
#
# Exit: 0 report produced (possibly with unchecked repos, which are named),
#       1 no usable token, 2 enumeration produced nothing.

set -u

OWNER=pmgledhill102
FORMAT=table
REPO_LIST=""

while [ $# -gt 0 ]; do
    case "$1" in
        --json)   FORMAT=json ;;
        --owner)  shift; OWNER="${1:-}" ;;
        --repos)  shift; REPO_LIST="${1:-}" ;;
        -h|--help)
            sed -n '/^# Usage:/,/^#       2 enum/p' "$0" | sed 's/^# \{0,1\}//'
            exit 0 ;;
        *) echo "estate-report: unknown option $1" >&2; exit 1 ;;
    esac
    shift
done

command -v jq > /dev/null 2>&1 || { echo "estate-report: needs jq" >&2; exit 1; }

# --- token -----------------------------------------------------------------
# Three sources in descending convenience. A missing token must fail loudly:
# an unauthenticated call still returns 200 with public data only, so a silent
# fallback would print a confident, wrong, half-empty estate.
TOKEN="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
if [ -z "$TOKEN" ] && command -v gh > /dev/null 2>&1; then
    TOKEN=$(gh auth token 2> /dev/null || true)
fi
if [ -z "$TOKEN" ]; then
    echo "estate-report: no token. Set GH_TOKEN or GITHUB_TOKEN, or run 'gh auth login'." >&2
    exit 1
fi

API=https://api.github.com
WORK=$(mktemp -d) || exit 1
trap 'rm -rf "$WORK"' EXIT INT TERM

# get <path> <outfile> -- one page. Prints the HTTP status on stdout so the
# caller can tell "empty because there is nothing" from "empty because it
# failed", which is the distinction that decides unchecked versus clean.
get() {
    curl -sS --max-time 30 -o "$2" -w '%{http_code}' \
        -H "Authorization: Bearer $TOKEN" \
        -H "Accept: application/vnd.github+json" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        "$API$1" 2> /dev/null || echo 000
}

# One repo's row, from the single /issues response. Every age is computed by
# jq rather than `date`, for the portability reason in the header.
cat > "$WORK/row.jq" <<'JQ'
def age: (now - fromdateiso8601) / 86400 | floor;
def prio: [.labels[].name] | map(select(test("^P[0-4]$"))) | (first // "none");
def bot: .user.login | endswith("[bot]");

{ issues: map(select(has("pull_request") | not)),
  prs:    map(select(has("pull_request"))) }
| {
    repo:         $repo,
    open:         (.issues | length),
    p0:           (.issues | map(select(prio == "P0")) | length),
    p1:           (.issues | map(select(prio == "P1")) | length),
    p24:          (.issues | map(select(prio | test("^P[234]$"))) | length),
    untriaged:    (.issues | map(select(prio == "none")) | length),
    human:        (.prs | map(select(bot | not)) | length),
    bot:          (.prs | map(select(bot)) | length),
    oldest_human: (.prs | map(select(bot | not) | .created_at | age) | max // 0),
    oldest_bot:   (.prs | map(select(bot) | .created_at | age) | max // 0),
    push_age:     ($meta[0].pushed_at | age),
    exceptions:   (.issues | map(select(prio | test("^P[01]$"))
                                 | {p: prio, n: .number, t: .title}))
  }
JQ

# --- 1. enumerate ----------------------------------------------------------
# Keep forks. This is deliberately NOT repo-audit.sh's rule, which drops them
# because upstream owns their settings -- settings-scoped reasoning. A fork
# under this account can carry its own issues and PRs, and that is work.
#
# Filter on owner. /user/repos also returns org repos the token can see, and
# desertfoxclan is explicitly not part of this estate.
if [ -n "$REPO_LIST" ]; then
    echo "$REPO_LIST" | tr ',' '\n' | sed '/^$/d' > "$WORK/repos"
else
    page=1
    : > "$WORK/repos"
    while [ "$page" -le 10 ]; do
        code=$(get "/user/repos?per_page=100&affiliation=owner&page=$page" "$WORK/page.json")
        [ "$code" = "200" ] || { echo "estate-report: repo list failed (HTTP $code)" >&2; break; }
        count=$(jq 'length' "$WORK/page.json")
        jq -r --arg o "$OWNER" \
            '.[] | select(.archived | not) | select(.owner.login == $o) | .name' \
            "$WORK/page.json" >> "$WORK/repos"
        [ "$count" -eq 100 ] || break
        page=$((page + 1))
    done
fi

REPO_COUNT=$(wc -l < "$WORK/repos" | tr -d ' ')
if [ "$REPO_COUNT" -eq 0 ]; then
    echo "estate-report: no repositories found for owner '$OWNER'." >&2
    echo "  A repo-scoped token (a sandbox installation token) cannot list an account's" >&2
    echo "  repositories. Pass --repos a,b,c, or run where a user token is available." >&2
    exit 2
fi

# --- 2. gather -------------------------------------------------------------
# One call per repo: REST /issues returns issues AND pull requests, split by
# the `pull_request` key. The GraphQL-backed tooling needs two calls for the
# same thing, so this halves the run.
: > "$WORK/rows.jsonl"
: > "$WORK/unchecked"

while IFS= read -r repo; do
    [ -n "$repo" ] || continue

    code=$(get "/repos/$OWNER/$repo" "$WORK/meta.json")
    if [ "$code" != "200" ]; then
        echo "$repo	repo metadata (HTTP $code)" >> "$WORK/unchecked"
        continue
    fi

    page=1
    echo '[]' > "$WORK/all.json"
    failed=""
    while [ "$page" -le 10 ]; do
        code=$(get "/repos/$OWNER/$repo/issues?state=open&per_page=100&page=$page" "$WORK/iss.json")
        if [ "$code" != "200" ]; then
            failed="HTTP $code"
            break
        fi
        count=$(jq 'length' "$WORK/iss.json")
        jq -s '.[0] + .[1]' "$WORK/all.json" "$WORK/iss.json" > "$WORK/merged.json" \
            && mv "$WORK/merged.json" "$WORK/all.json"
        [ "$count" -eq 100 ] || break
        page=$((page + 1))
    done

    if [ -n "$failed" ]; then
        echo "$repo	issues ($failed)" >> "$WORK/unchecked"
        continue
    fi

    jq -c --arg repo "$repo" --slurpfile meta "$WORK/meta.json" -f "$WORK/row.jq" \
        "$WORK/all.json" >> "$WORK/rows.jsonl" 2> /dev/null \
        || echo "$repo	aggregation" >> "$WORK/unchecked"
done < "$WORK/repos"

# --- 3. derive and render --------------------------------------------------
# Flags are ordered and exclusive: a repo gets the first that matches, and the
# table sorts by that order, so the top rows are the answer to "what now".
#
# A repo matching none is UNFLAGGED, and that is a real state rather than a
# gap -- a large backlog being actively worked is exactly the case these flags
# exist not to raise. Do not add a seventh flag to fill it.
cat > "$WORK/render.jq" <<'JQ'
def pad($n): tostring as $s | $s + ((" " * ($n - ($s | length))) // "");
def rpad($n): tostring as $s | ((" " * ($n - ($s | length))) // "") + $s;
# Repo names run past any width worth reserving, and one long name shifts every
# column on every other row. Truncate rather than let the table break.
def trunc($n): tostring | if length > $n then .[0:$n - 1] + "~" else . end;

def flag:
  if   .p0 > 0                                   then "P0"
  elif .human > 0 and .oldest_human > 7          then "blocked"
  elif .bot >= 5 and .oldest_bot > 14            then "automation"
  elif .p1 > 0 and .push_age > 30                then "stalled"
  elif .untriaged > 5                            then "untriaged"
  elif .open == 0 and (.human + .bot) == 0       then "quiet"
  else "" end;

def rank:
  {"P0": 0, "blocked": 1, "automation": 2,
   "stalled": 3, "untriaged": 4, "": 5, "quiet": 6}[.flag] // 5;

def row:
  (.repo | trunc(23) | pad(24))
  + (.open | rpad(5))
  + (.p0 + .p1 | rpad(6))
  + (.p24 | rpad(6))
  + (.untriaged | rpad(7))
  + (("\(.human) / \(.bot)") | rpad(11))
  + (("\(.push_age)d") | rpad(7))
  + "  " + .flag;

map(. + {flag: flag}) as $rows
| ($rows | map(select(.flag != "quiet")) | sort_by(rank, -.open)) as $active
| ($rows | map(select(.flag == "quiet")) | map(.repo) | sort)     as $quiet
| ($rows | map(.exceptions[] + {repo: .repo}) | sort_by(.p, .repo)) as $exc
| [ "estate — \($rows | length) repos, as of \($now)",
    "",
    "P0 / P1 across the estate (\($exc | length))",
    ""
  ]
  + ($exc | map("  \(.p)  \(.repo)#\(.n)  \(.t)"))
  + [ "", "",
      ("repo" | pad(24)) + ("open" | rpad(5)) + ("P0-1" | rpad(6))
        + ("P2-4" | rpad(6)) + ("untri" | rpad(7)) + ("you/bot" | rpad(11))
        + ("push" | rpad(7)) + "  flag",
      ("-" * 74)
    ]
  + ($active | map(row))
  + (if ($quiet | length) > 0
     then ["", "quiet (\($quiet | length)): \($quiet | join(", "))"]
     else [] end)
| .[]
JQ

NOW=$(date -u +%Y-%m-%dT%H:%MZ)

if [ "$FORMAT" = json ]; then
    jq -s --arg now "$NOW" --arg owner "$OWNER" \
        '{generated_at: $now, owner: $owner, repos: .}' "$WORK/rows.jsonl"
else
    jq -s -r --arg now "$NOW" -f "$WORK/render.jq" "$WORK/rows.jsonl"
fi

# --- 4. unchecked ----------------------------------------------------------
# Never silent. A repo dropped without a word is indistinguishable from a
# healthy one, which is the exact failure this report exists to catch.
if [ -s "$WORK/unchecked" ]; then
    echo ""
    echo "not checked ($(wc -l < "$WORK/unchecked" | tr -d ' ')) — these are UNKNOWN, not clean:"
    while IFS="	" read -r repo reason; do
        echo "  $repo — $reason"
    done < "$WORK/unchecked"
fi

exit 0
