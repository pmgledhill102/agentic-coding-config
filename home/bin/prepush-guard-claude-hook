#!/bin/sh
# prepush-guard-claude-hook — Claude Code PreToolUse(Bash) hook.
#
# Blocks `git push` to a branch whose PR has already been merged or closed.
# The failure this prevents: the user merges the PR via the GitHub UI
# mid-session (branch auto-deletes), and the next push silently recreates an
# orphaned remote branch — the only tell is `* [new branch]` in output nobody
# reads. Recovery costs a cleanup cycle every time (new branch, cherry-pick,
# delete orphan, new PR). The prose rule in CLAUDE.md ("check the PR is still
# open before pushing") failed twice in one session; this enforces it.
#
# Authority is `gh pr view <branch>`: local state is useless here (the stale
# remote-tracking ref survives the remote deletion until a fetch --prune).
# gh prefers an open PR for the branch when one exists, so re-using a branch
# name after an old PR merged still pushes fine once a new PR is open.
#
# Fail-open by design: no gh, no network, no repo, detached HEAD, or any
# lookup error -> allow the push. The guard exists to stop one specific
# silent mistake, not to make pushing fragile. Honours --no-verify as the
# escape hatch, same as precommit-claude-hook.
#
# Fail-open is not fail-silent. Every stand-down that leaves a real push
# unexamined prints one `prepush-guard: not checked -- <reason>` line on
# stderr, with a reason distinct enough to grep, because the fixes differ:
# an unresolvable path is the command's wording (rewrite it with a literal
# path), while a missing or unauthenticated gh is a fact about the machine.
# Pushes the guard has no business with -- not a git push, an escape hatch,
# the default branch, no PR for the branch -- stay silent.
#
# Limitation: checks the CURRENT branch. A push that names a different
# refspec than the checked-out branch is waved through unexamined.

set -u

# --- Read payload; degrade gracefully without jq. -------------------------
command -v jq >/dev/null 2>&1 || exit 0
payload=$(cat)
cmd=$(printf '%s' "$payload" | jq -r '.tool_input.command // empty')
cwd=$(printf '%s' "$payload" | jq -r '.cwd // empty')

# --- Fast-exit: fires on EVERY Bash call, so not-a-push must be cheap. ----
# Matching the literal phrase "git push" missed `git -C <path> push`, which is
# one of the two shapes #404 is about -- so the guard silently waved through
# exactly the cross-repo form it was being fixed to handle. This is the cheap
# half of the test; resolve_command_dir below does the positional match, the
# way precommit-claude-hook already classifies.
case "$cmd" in
  *push*) ;;
  *) exit 0 ;;
esac
case "$cmd" in
  *" --no-verify "*|*" --no-verify") exit 0 ;;      # standard escape hatch
  *" --delete "*|*" --delete"|*" -d "*) exit 0 ;;   # deleting, not pushing work
  *" --tags"*) exit 0 ;;                            # tag pushes have no PR
esac

# not_checked <reason> -- the one stand-down message shape (see header).
not_checked() {
  printf 'prepush-guard: not checked -- %s\n' "$1" >&2
  exit 0
}

# --- Resolve the repo the push targets, then its branch (see limitation). -
# The walk over `cd` / `git -C` lives in lib/resolve-command-dir, shared with
# precommit-claude-hook. A missing lib fails open like everything else here:
# dash exits 2 on a failed `.`, and 2 is the one exit code that blocks.
rcd_lib="$(dirname -- "$0")/lib/resolve-command-dir"
[ -r "$rcd_lib" ] || not_checked "lib missing: $rcd_lib is not installed."
# shellcheck source=/dev/null  # lib/resolve-command-dir, resolved at run time
. "$rcd_lib"

# Anything unresolvable (status 2) skips the guard instead of guessing. A
# PreToolUse denial rejects the WHOLE Bash call, so a false positive also
# destroys any heredoc or file write earlier in the same command -- that cost
# a rewritten script three times in one session (#404). An unguarded push
# costs one orphan branch; a false positive costs the whole tool call.
# Status 1 (no `git push` segment: "push" was only mentioned) stays silent.
target=$(resolve_command_dir "$cmd" "${cwd:-$PWD}" push)
case $? in
  0) ;;
  2) not_checked "unresolvable path: the push runs in a directory that cannot be resolved before the command runs (variable, substitution, glob, quoted or ~ path, or subshell/pushd nesting). Use a literal path to have it checked." ;;
  *) exit 0 ;;
esac
[ -n "$target" ] || exit 0
root=$(git -C "$target" rev-parse --show-toplevel 2>/dev/null) || exit 0

branch=$(git -C "$root" symbolic-ref --short -q HEAD) || exit 0   # detached HEAD
default=$(git -C "$root" symbolic-ref --short -q refs/remotes/origin/HEAD | sed 's|^origin/||')
[ -n "$default" ] && [ "$branch" = "$default" ] && exit 0

# Checked after resolution, so a command that merely mentions "push" never
# reports a missing gh.
command -v gh >/dev/null 2>&1 || not_checked "gh unavailable: gh is not installed, so the PR state cannot be looked up."

# --- Ask GitHub. Any failure (no PR, offline, auth) -> allow. -------------
# gh exits 4 when authentication is required; its "no pull requests found"
# is the ordinary no-PR-yet case and stays silent.
gh_err_file=$(mktemp 2>/dev/null) || gh_err_file=/dev/null
pr=$(cd "$root" && gh pr view "$branch" --json state,number,url 2>"$gh_err_file")
gh_rc=$?
gh_err=$(cat "$gh_err_file" 2>/dev/null)
[ "$gh_err_file" = /dev/null ] || rm -f "$gh_err_file"
if [ "$gh_rc" -ne 0 ]; then
  case "$gh_err" in
    *"no pull requests found"*) exit 0 ;;
  esac
  case "$gh_rc:$gh_err" in
    4:* | *"gh auth login"* | *"HTTP 401"* | *"Bad credentials"*)
      not_checked "gh unauthorised: gh is not authenticated, so the PR state cannot be looked up." ;;
  esac
  not_checked "gh lookup failed: $(printf '%s' "$gh_err" | head -1)"
fi
state=$(printf '%s' "$pr" | jq -r '.state // empty')
case "$state" in
  MERGED|CLOSED) ;;
  *) exit 0 ;;
esac

number=$(printf '%s' "$pr" | jq -r '.number')
url=$(printf '%s' "$pr" | jq -r '.url')
printf 'push blocked: PR #%s for branch %s is already %s (%s).\n\nPushing now would silently recreate the deleted remote branch as an orphan.\nStart from fresh main instead:\n  git checkout main && git pull --rebase && git checkout -b <new-branch>\nthen cherry-pick or re-apply the new commits and open a new PR.\n\n(If recreating this branch is genuinely intended, re-run with --no-verify.)\n' "$number" "$branch" "$state" "$url" >&2
exit 2
